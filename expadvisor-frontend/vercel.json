{
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/login.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/my_problems", "destination": "/frontend/my_problems.html" },
    { "source": "/my_profile", "destination": "/frontend/my_profile.html" },
    { "source": "/forgot_pass", "destination": "/frontend/forgot_pass.html" },
    { "source": "/reset_password", "destination": "/frontend/reset_password.html" },
    { "source": "/solve", "destination": "/frontend/solve.html" },
    { "source": "/student_directory", "destination": "/frontend/student_directory.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
